{
  "name": "@initiative/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run models && vite --host",
    "models": "node scripts/prepare-models.mjs",
    "prebuild": "node scripts/prepare-models.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "check:cutout": "node scripts/check-cutout.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@initiative/shared": "workspace:*",
    "@mediapipe/tasks-vision": "^1.0.1",
    "idb": "^8.0.1",
    "onnxruntime-web": "^1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "workbox-precaching": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
