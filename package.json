{
  "name": "initiative",
  "version": "0.1.0",
  "private": true,
  "description": "Initiative \u2013 modulare PWA-Plattform (Rust-API + React-PWA), erstes Modul: Messenger",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:web": "node scripts/dev.mjs web",
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "cargo build --release --manifest-path apps/api/Cargo.toml",
    "build:web": "pnpm --filter @initiative/web build",
    "typecheck": "pnpm -r typecheck && cargo check --manifest-path apps/api/Cargo.toml --all-targets",
    "test": "cargo test --manifest-path apps/api/Cargo.toml && pnpm -r test",
    "test:api": "cargo test --manifest-path apps/api/Cargo.toml",
    "test:web": "pnpm -r test",
    "lint": "cargo clippy --manifest-path apps/api/Cargo.toml --all-targets -- -D warnings",
    "fmt": "cargo fmt --manifest-path apps/api/Cargo.toml && prettier --write \"apps/web/**/*.{ts,tsx,css,json,md}\" \"packages/**/*.{ts,json,md}\" \"*.{json,md}\"",
    "keys:vapid": "cargo run --manifest-path apps/api/Cargo.toml -- --generate-vapid-keys"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
