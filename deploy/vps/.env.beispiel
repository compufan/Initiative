# /opt/initiative/.env  –  chmod 600, gehört dem Deploy-Benutzer.
# Nichts hiervon steht im Abbild; alles wird zur Laufzeit gelesen.

# Welcher Stand läuft. deploy.sh setzt das; von Hand nur zum Zurückrollen.
IMAGE_TAG=live

# WICHTIG: Freitext IMMER in doppelte Anführungszeichen setzen. backup.sh liest
# diese Datei mit `. ./.env` als Shell-Skript – ein Leerzeichen ohne
# Anführungszeichen beendet die Sicherung mit „command not found", bevor der
# erste Abzug läuft. Docker Compose entfernt die Anführungszeichen wieder.

# --- Domain und TLS ---------------------------------------------------------
DOMAIN=initiative.example.de
ACME_EMAIL=du@example.de

# Nur solange die App unter einem geliehenen Hostnamen läuft (netcup
# v2202….nicesrv.de). Auf der eigenen Domain diese Zeile löschen – siehe
# Caddyfile.
# HSTS_MAX_AGE=300

# Beide auf dieselbe Domain. PUBLIC_API_URL baut JEDE Medienadresse – ein
# Tippfehler hier macht alle Bilder unsichtbar, ohne dass sonst etwas auffällt.
PUBLIC_APP_URL=https://initiative.example.de
PUBLIC_API_URL=https://initiative.example.de
# Leer lassen. Bei einer gemeinsamen Domain gibt es keine Cross-Origin-
# Anfragen. Niemals `*`: das schaltet allow_credentials ab.
CORS_ORIGINS=

# An welchen Namen Passkeys gebunden werden.
#
# DIE EINE ENTSCHEIDUNG, DIE SICH NIE MEHR KORRIGIEREN LAESST. Ein Passkey gilt
# fuer genau den Namen, unter dem er angelegt wurde.
#
# Laeuft die App unter einer Unterdomain (app.beispiel.de), dann hier die
# Hauptdomain (beispiel.de) eintragen: Dann kannst du spaeter umziehen, ohne
# dass jemand seinen Schluessel verliert. Laeuft sie direkt unter beispiel.de,
# kann das Feld leer bleiben.
WEBAUTHN_RP_ID=

# --- Datenbank --------------------------------------------------------------
POSTGRES_USER=initiative
# Nur Buchstaben, Ziffern, Bindestrich und Unterstrich. Die Verbindungsadresse
# wird daraus zusammengesetzt; ein @ : / # oder ? darin zerlegt sie, und der
# Fehler sieht danach nach allem Möglichen aus, nur nicht nach dem Passwort.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=initiative

# --- Geheimnisse: ÜBERNEHMEN, nicht neu erzeugen ---------------------------
# Ein neues JWT_SECRET meldet jeden ab. Neue VAPID-Schlüssel machen jedes
# Push-Abo ungültig, und jeder muss Benachrichtigungen neu erlauben.
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.de

# --- Verschluesselung der Dateien -------------------------------------------
# Bilder, Videos und Anhaenge liegen damit verschluesselt auf der Platte. Wer
# den Upload-Ordner in die Finger bekommt - ueber eine Sicherung, einen
# Abzug der virtuellen Platte, einen falsch freigegebenen Pfad - findet dort
# Zufallsbytes.
#
#   openssl rand -base64 32
#
# (Nicht `docker compose run --rm api initiative-api --generate-media-key`:
# Compose fordert MEDIA_KEY schon beim Einlesen der Datei ein – der Befehl
# bricht also ab, bevor der Container startet, der den Schlüssel erzeugen
# soll. `openssl` liefert bitgenau dasselbe: 32 Zufallsbytes in base64.)
#
# ZWEI DINGE, BEIDE WICHTIG:
#   1. Diesen Schluessel getrennt von den Sicherungen aufbewahren. Liegt er
#      daneben, war die ganze Uebung umsonst.
#   2. Ohne ihn sind die Dateien endgueltig weg. Es gibt keine Hintertuer.
# Ins Passwortprogramm damit, bevor du weitermachst.
MEDIA_KEY=

# --- Konten -----------------------------------------------------------------
REGISTRATION_MODE=invite

# DER NOTNAGEL FÜR DAS ALLERERSTE KONTO. Ohne ihn kommt bei leerer Datenbank
# NIEMAND hinein, auch du nicht: Registrieren verlangt einen Code, Codes
# anlegen verlangt ein Verwalterkonto, und Verwalter wird nur, wer angemeldet
# ist. Eine geschlossene Schleife.
#
#   openssl rand -hex 8
#
# Mehrere Codes durch Komma getrennt. Nach dem ersten Konto wieder LEEREN und
# `docker compose up -d --force-recreate api`: Ein Code aus dieser Datei läuft
# nie ab, lässt sich nicht widerrufen und taucht im Verwaltungsbereich nicht
# auf – wer ihn einmal gesehen hat, kommt dauerhaft herein.
INVITE_CODES=

# Schaltet den Verwaltungsbereich frei. Unter 8 Zeichen wird es stillschweigend
# verworfen, und die Karte erscheint gar nicht erst.
#   openssl rand -hex 16
ADMIN_PASSWORD=

# --- Betreiberangaben für /datenschutz --------------------------------------
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# --- Backup -----------------------------------------------------------------
# Oeffentlicher age-Schluessel, mit dem die Datenbank-Abzuege verschluesselt
# werden (beginnt mit "age1").
#
# Der Witz am oeffentlichen Schluessel: Der Server kann Sicherungen SCHREIBEN,
# aber keine einzige davon lesen. Selbst wer die Maschine vollstaendig
# uebernimmt, kommt an die Abzuege von gestern nicht heran - der private
# Schluessel liegt bei dir zu Hause und nie hier.
#
# Erzeugen (auf deinem Geraet, NICHT auf dem Server):
#   age-keygen -o initiative-backup.key
# Die Zeile "Public key: age1..." kommt hier hinein, die Datei selbst gehoert
# ins Passwortprogramm.
#
# Leer lassen = Abzuege liegen im Klartext unter /var/backups/initiative.
BACKUP_PUBKEY=

# Ziel ausser Haus, z. B. eine Hetzner Storage Box. Leer lassen = nur lokal.
# restic verschluesselt selbst noch einmal - das ist kein Widerspruch, sondern
# schuetzt zwei verschiedene Orte.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/initiative/restic-passwort
# Ein Dienst, der nur bei Erfolg angepingt wird und Alarm schlägt, wenn nichts
# kommt (healthchecks.io o. ä.). Leer lassen = keine Meldung.
HEALTHCHECK_URL=
