# /opt/initiative/.env  –  chmod 600, gehört dem Deploy-Benutzer.
# Nichts hiervon steht im Abbild; alles wird zur Laufzeit gelesen.

# Welcher Stand läuft. deploy.sh setzt das; von Hand nur zum Zurückrollen.
IMAGE_TAG=live

# --- Domain und TLS ---------------------------------------------------------
DOMAIN=initiative.example.de
ACME_EMAIL=du@example.de

# Beide auf dieselbe Domain. PUBLIC_API_URL baut JEDE Medienadresse – ein
# Tippfehler hier macht alle Bilder unsichtbar, ohne dass sonst etwas auffällt.
PUBLIC_APP_URL=https://initiative.example.de
PUBLIC_API_URL=https://initiative.example.de
# Leer lassen. Bei einer gemeinsamen Domain gibt es keine Cross-Origin-
# Anfragen. Niemals `*`: das schaltet allow_credentials ab.
CORS_ORIGINS=

# An welchen Namen Passkeys gebunden werden.
#
# DIE EINE ENTSCHEIDUNG, DIE SICH NIE MEHR KORRIGIEREN LAESST. Ein Passkey gilt
# fuer genau den Namen, unter dem er angelegt wurde.
#
# Laeuft die App unter einer Unterdomain (app.beispiel.de), dann hier die
# Hauptdomain (beispiel.de) eintragen: Dann kannst du spaeter umziehen, ohne
# dass jemand seinen Schluessel verliert. Laeuft sie direkt unter beispiel.de,
# kann das Feld leer bleiben.
WEBAUTHN_RP_ID=

# --- Datenbank --------------------------------------------------------------
POSTGRES_USER=initiative
# Nur Buchstaben, Ziffern, Bindestrich und Unterstrich. Die Verbindungsadresse
# wird daraus zusammengesetzt; ein @ : / # oder ? darin zerlegt sie, und der
# Fehler sieht danach nach allem Möglichen aus, nur nicht nach dem Passwort.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=initiative

# --- Geheimnisse: ÜBERNEHMEN, nicht neu erzeugen ---------------------------
# Ein neues JWT_SECRET meldet jeden ab. Neue VAPID-Schlüssel machen jedes
# Push-Abo ungültig, und jeder muss Benachrichtigungen neu erlauben.
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.de

# --- Konten -----------------------------------------------------------------
REGISTRATION_MODE=invite
# Unter 8 Zeichen wird es stillschweigend verworfen und der
# Verwaltungsbereich bleibt aus.
ADMIN_PASSWORD=

# --- Betreiberangaben für /datenschutz --------------------------------------
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# --- Backup -----------------------------------------------------------------
# Ziel ausser Haus, z. B. eine Hetzner Storage Box. Leer lassen = nur lokal.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/initiative/restic-passwort
# Ein Dienst, der nur bei Erfolg angepingt wird und Alarm schlägt, wenn nichts
# kommt (healthchecks.io o. ä.). Leer lassen = keine Meldung.
HEALTHCHECK_URL=
