# ---------------------------------------------------------------------------
# Initiative – Beispielkonfiguration
# Kopiere diese Datei nach .env (lokal) bzw. trage die Werte beim Hoster ein.
# ---------------------------------------------------------------------------

# --- API (apps/api, Rust) --------------------------------------------------
# NODE_ENV steuert auch die Rust-API (development | test | production)
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Neon / Supabase / eigener Postgres. Für Neon die "pooled" Connection nehmen.
# TLS steuerst du über die URL: ?sslmode=require (Neon/Supabase) bzw. weglassen
# für lokales Postgres – sqlx richtet sich danach.
DATABASE_URL=postgres://user:password@localhost:5432/initiative
DATABASE_POOL_MAX=10

# openssl rand -base64 48
JWT_SECRET=bitte-ersetzen-mindestens-32-zeichen
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=60

# Öffentliche URLs (für Push-Links, Medien-URLs und den Kalender-Feed)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# open | invite | closed
REGISTRATION_MODE=open
INVITE_CODES=

# --- Storage ---------------------------------------------------------------
# local = Dateien auf der Platte (Entwicklung / Single-Server)
# r2    = Cloudflare R2, s3 = AWS S3 / MinIO / Backblaze
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/uploads
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=initiative-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional: öffentliche Domain des Buckets (dann werden keine signierten URLs erzeugt)
S3_PUBLIC_BASE_URL=
SIGNED_URL_TTL=3600

# Verschluesselung der abgelegten Dateien (32 Bytes, base64).
#   initiative-api --generate-media-key
# Leer = wie bisher, Dateien liegen im Klartext.
#
# Zwei Dinge dazu, beide wichtig:
#   1. Der Schluessel gehoert NICHT in dieselbe Sicherung wie die Dateien.
#      Sonst liegt er neben dem, was er schuetzen soll.
#   2. Ohne ihn sind die damit abgelegten Dateien endgueltig verloren. Es gibt
#      keine Hintertuer.
# Einschalten geht jederzeit: Was schon da ist, bleibt lesbar, alles Neue wird
# verschluesselt. Ausschalten gilt umgekehrt NICHT - dann sind die
# verschluesselten Dateien weg.
MEDIA_KEY=

# --- Web Push (pnpm --filter @initiative/api keys:vapid) --------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# postgres = LISTEN/NOTIFY (mehrere Instanzen), memory = eine Instanz
REALTIME_BUS=postgres

# Migrationen beim Start automatisch anwenden (sie stecken in der Binary)
RUN_MIGRATIONS=true

# Notfall-Schalter. Wurde eine Migrationsdatei nach dem Ausfuehren veraendert,
# verweigert sqlx JEDE weitere Migration ("VersionMismatch"). Mit diesem
# Schalter gleicht der Server die Pruefsumme einmal an und laesst die offenen
# Migrationen durchlaufen. Danach wieder entfernen - sonst wuerde er kuenftige
# Aenderungen an bereits ausgefuehrten Migrationen stillschweigend durchwinken.
# In Produktion nicht von Hand setzen, sondern ueber GitHub -> Actions ->
# "API-Wartung" -> Aufgabe "migration-reparieren".
# MIGRATIONS_REPAIR=1

# --- PWA (apps/web) --------------------------------------------------------
# Leer lassen, wenn Frontend und API unter derselben Domain laufen.
VITE_API_URL=
VITE_DEV_API_PROXY=http://localhost:8080
# Werden im Profil unter "Über" angezeigt.
VITE_APP_VERSION=0.1.0
VITE_REPO_URL=https://github.com/compufan/Initiative

# --- Betreiberangaben fuer die Datenschutzerklaerung ------------------------
# Art. 13 DSGVO verlangt Namen und Kontakt des Verantwortlichen. Ohne diese
# Angaben ist die Seite unter /datenschutz unvollstaendig und sagt das auch.
# OPERATOR_NAME="Vorname Nachname"
# OPERATOR_ADDRESS="Strasse 1, 12345 Ort"
# OPERATOR_EMAIL="du@example.com"
